# --------------------------------------------------
# GROQ API KEYS (LLM & Transcription)
# --------------------------------------------------
GROQ_API_KEY=your_groq_api_key_here

# --------------------------------------------------
# QDRANT CLOUD CREDS
# --------------------------------------------------
QDRANT_URL=https://8d88d793-5447-4f29-b169-ebb8a17a1137.eu-west-1-0.aws.cloud.qdrant.io
QDRANT_API_KEY=your_qdrant_cloud_api_key_here
COLLECTION_NAME=tiet_policy_docs

# --------------------------------------------------
# UPSTASH REDIS CREDS (Optional - Falls back to in-memory)
# --------------------------------------------------
REDIS_URL=rediss://default:your_token_here@your_endpoint.upstash.io:6379

# --------------------------------------------------
# VISION MODEL CONFIG
# --------------------------------------------------
# Default standard Groq model. Change to llama-3.2-11b-vision-preview if preferred.
VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
