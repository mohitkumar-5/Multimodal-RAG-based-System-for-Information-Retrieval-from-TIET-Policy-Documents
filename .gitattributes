# Tell GitHub Linguist what to count and what to ignore
# This controls the language bar shown on your repo

# Mark notebooks as documentation (removes them from language stats)
notebooks/*.ipynb linguist-documentation

# Count these as the main languages
*.py linguist-detectable=true
*.js linguist-detectable=true
*.css linguist-detectable=true
*.html linguist-detectable=true

# Exclude Dockerfile from stats (too small to matter)
Dockerfile linguist-detectable=false
